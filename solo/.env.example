# Copy to .env and fill in for a real deployment. Never commit the real .env file.

# Port the server listens on.
PORT=4317

# development | production
NODE_ENV=development

# Set to "true" only for local/offline testing. Bypasses real SMS delivery by
# printing the one-time code to the server console and returning it in the API
# response. Must NEVER be true when NODE_ENV=production — the server refuses to
# start if both are set.
DEV_PREVIEW=false

# Where the SQLite file lives. Defaults to ./data/solo.db if unset.
DB_PATH=./data/solo.db

# Twilio Verify — required for real SMS one-time codes (trainee login + admin 2FA).
# Leave empty until an account is created and the cost is approved.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
