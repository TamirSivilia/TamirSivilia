# Copy to .env and fill in before running in production.

# Sets the fixed admin login password. If unset, a random one-time password
# is generated on first run and printed to the server console — set this
# explicitly instead of relying on that.
ADMIN_PASSWORD=

# development | production. Production disables the dev_code echo on the
# learner OTP endpoint (see README: SMS delivery is not wired up yet).
NODE_ENV=production

PORT=4317
HOST=127.0.0.1

# Where the SQLite file is written. Defaults to ./data/solo.db
SOLO_DB_PATH=

# --- Not yet used: SMS delivery (Twilio) ---
# Until these are set and server.mjs is wired to call Twilio, learner login
# codes are only logged server-side and visible in /admin under "קודי כניסה".
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
